---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Setup">
  <div class="wrap">
    <form class="card" id="setup-form">
      <h2><span class="accent">bowser</span></h2>
      <p class="sub">first run - create the admin account</p>

      <label for="username">username</label>
      <input id="username" name="username" type="text" autocomplete="username" required autofocus />

      <label for="password">password <span class="hint">(min 8 chars)</span></label>
      <input id="password" name="password" type="password" autocomplete="new-password" required minlength="8" />

      <label for="confirm">confirm password</label>
      <input id="confirm" name="confirm" type="password" autocomplete="new-password" required minlength="8" />

      <div class="error" id="error" hidden></div>

      <button type="submit" id="submit">create account</button>
    </form>
  </div>
</Layout>

<script>
  const $form = document.getElementById("setup-form") as HTMLFormElement;
  const $error = document.getElementById("error")!;
  const $submit = document.getElementById("submit") as HTMLButtonElement;

  const showError = (msg: string) => {
    $error.textContent = msg;
    $error.hidden = false;
  };

  $form.addEventListener("submit", async e => {
    e.preventDefault();
    $error.hidden = true;

    const data = new FormData($form);
    if (data.get("password") !== data.get("confirm")) {
      showError("passwords do not match");
      return;
    }

    $submit.disabled = true;
    $submit.textContent = "creating...";
    try {
      const res = await fetch("/api/auth/setup", {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify({ username: data.get("username"), password: data.get("password") })
      });
      if (res.ok) {
        location.href = "/";
        return;
      }
      const body = await res.json().catch(() => ({}));
      showError(body.error ?? "setup failed");
    } catch {
      showError("network error - is the server up?");
    }
    $submit.disabled = false;
    $submit.textContent = "create account";
  });
</script>

<style>
  .wrap {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .card {
    width: min(360px, 90vw);
    background-color: var(--secondary);
    border: var(--accent) 1px solid;
    padding: 28px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  h2 {
    margin: 0;
  }

  .sub {
    color: darkgray;
    margin: 0 0 16px;
  }

  .hint {
    color: darkgray;
    font-weight: normal;
  }

  label {
    color: lightgray;
    margin-top: 8px;
  }

  input {
    background-color: var(--primary);
    color: white;
    border: 1px solid var(--tertiary);
    padding: 8px 10px;
    font-family: inherit;
    outline: none;
  }

  input:focus {
    border-color: var(--accent);
  }

  button {
    margin-top: 16px;
    padding: 9px;
    font-family: inherit;
    font-weight: bold;
    background-color: var(--accent);
    color: var(--primary);
    border: none;
    cursor: pointer;
  }

  button:disabled {
    opacity: 0.6;
    cursor: wait;
  }

  .error {
    margin-top: 10px;
    color: #ff6b81;
  }
</style>
