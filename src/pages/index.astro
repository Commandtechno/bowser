---
import Explorer from "../components/Explorer.astro";
import MoveDialog from "../components/MoveDialog.astro";
import PreviewPanel from "../components/PreviewPanel.astro";
import ShareDialog from "../components/ShareDialog.astro";
import Sidebar from "../components/Sidebar.astro";
import UploadPanel from "../components/UploadPanel.astro";
import Layout from "../layouts/Layout.astro";

const canWrite = Astro.locals.user!.role !== "readonly";
---

<Layout title="Bowser">
  <div class="container">
    <Sidebar />
    <Explorer />
    <PreviewPanel />
  </div>
  <ShareDialog />
  <MoveDialog />
  <UploadPanel />
</Layout>

<script define:vars={{ canWrite }}>
  window.__canWrite = canWrite;
</script>

<style>
  .container {
    display: flex;
    height: 100%;
    gap: 10px;
  }
</style>

<script>
  import "../lib/path";
</script>
