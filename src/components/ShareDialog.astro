<dialog id="share-dialog">
  <div class="dialog-head">
    <h2>share folder</h2>
    <button class="close-btn" id="share-close" aria-label="close">✕</button>
  </div>
  <p class="hint" id="share-target"></p>

  <div id="share-form-view">
    <div class="row">
      <label for="share-duration">expires in</label>
      <select id="share-duration">
        <option value="3600">1 hour</option>
        <option value="86400" selected>1 day</option>
        <option value="259200">3 days</option>
        <option value="604800">1 week</option>
        <option value="2592000">30 days</option>
      </select>
    </div>
    <div class="row">
      <label for="share-protocol">also serve over</label>
      <select id="share-protocol">
        <option value="">web link only</option>
        <option value="webdav">WebDAV</option>
        <option value="sftp">SFTP</option>
        <option value="ftp">FTP</option>
        <option value="http">HTTP</option>
      </select>
    </div>
    <div class="inline">
      <button class="btn" id="share-create">create link</button>
      <span class="msg" id="share-msg"></span>
    </div>
  </div>

  <div id="share-result-view" hidden>
    <p class="hint">anyone with this link can browse and download this folder until it expires.</p>
    <div class="inline">
      <input type="text" id="share-link-input" readonly />
      <button class="btn" id="share-copy">copy</button>
    </div>
    <p class="hint" id="share-expiry-note"></p>
    <p class="hint">manage or revoke this link anytime from settings.</p>

    <p class="hint err" id="serve-error" hidden></p>

    <div id="share-serve-view" hidden>
      <div class="serve-card">
        <div class="serve-head">
          <span class="serve-badge" id="serve-protocol-badge"></span>
          <span class="hint">read-only - expires with the link above</span>
        </div>

        <div class="serve-fields">
          <div class="serve-field">
            <label for="serve-host">host</label>
            <div class="inline">
              <input type="text" id="serve-host" readonly />
              <button class="btn small" id="serve-host-copy">copy</button>
            </div>
          </div>
          <div class="serve-field">
            <label for="serve-port">port</label>
            <div class="inline">
              <input type="text" id="serve-port" readonly />
              <button class="btn small" id="serve-port-copy">copy</button>
            </div>
          </div>
          <div class="serve-field">
            <label for="serve-user">username</label>
            <div class="inline">
              <input type="text" id="serve-user" readonly />
              <button class="btn small" id="serve-user-copy">copy</button>
            </div>
          </div>
          <div class="serve-field">
            <label for="serve-password">password</label>
            <div class="inline">
              <input type="text" id="serve-password" readonly />
              <button class="btn small" id="serve-password-copy">copy</button>
            </div>
          </div>
        </div>

        <label class="hint" for="serve-command">pull the whole folder in one shot:</label>
        <div class="inline">
          <input type="text" id="serve-command" readonly />
          <button class="btn small" id="serve-command-copy">copy</button>
        </div>
      </div>
    </div>
  </div>
</dialog>

<script>
  import { showToast } from "../lib/toast";

  const $dialog = document.getElementById("share-dialog") as HTMLDialogElement;
  const $target = document.getElementById("share-target")!;
  const $formView = document.getElementById("share-form-view")!;
  const $resultView = document.getElementById("share-result-view")!;
  const $duration = document.getElementById("share-duration") as HTMLSelectElement;
  const $protocol = document.getElementById("share-protocol") as HTMLSelectElement;
  const $create = document.getElementById("share-create") as HTMLButtonElement;
  const $msg = document.getElementById("share-msg")!;
  const $linkInput = document.getElementById("share-link-input") as HTMLInputElement;
  const $copy = document.getElementById("share-copy")!;
  const $expiryNote = document.getElementById("share-expiry-note")!;
  const $serveView = document.getElementById("share-serve-view")!;
  const $serveError = document.getElementById("serve-error")!;
  const $serveBadge = document.getElementById("serve-protocol-badge")!;
  const $serveHost = document.getElementById("serve-host") as HTMLInputElement;
  const $servePort = document.getElementById("serve-port") as HTMLInputElement;
  const $serveUser = document.getElementById("serve-user") as HTMLInputElement;
  const $servePassword = document.getElementById("serve-password") as HTMLInputElement;
  const $serveCommand = document.getElementById("serve-command") as HTMLInputElement;

  let currentPath: string[] = [];

  const flash = (text: string, ok: boolean) => {
    $msg.textContent = text;
    $msg.classList.toggle("ok", ok);
    $msg.classList.toggle("err", !ok);
  };

  const durationSeconds = (): number => Number($duration.value);

  window.addEventListener("openShareDialog", e => {
    currentPath = (e as CustomEvent<{ path: string[] }>).detail.path;
    $target.textContent = `/${currentPath.join("/")}`;
    $formView.hidden = false;
    $resultView.hidden = true;
    $serveView.hidden = true;
    $serveError.hidden = true;
    $protocol.value = "";
    $msg.textContent = "";
    $create.disabled = false;
    $create.textContent = "create link";
    $dialog.showModal();
  });

  document.getElementById("share-close")!.addEventListener("click", () => $dialog.close());
  $dialog.addEventListener("click", e => {
    if (e.target === $dialog) $dialog.close();
  });

  $create.addEventListener("click", async () => {
    $create.disabled = true;
    $create.textContent = "creating…";
    flash("", true);
    $serveView.hidden = true;
    $serveError.hidden = true;

    try {
      const protocol = $protocol.value || undefined;
      const res = await fetch("/api/shares", {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify({ path: currentPath.join("/"), durationSeconds: durationSeconds(), protocol })
      });
      if (!res.ok) {
        const body = await res.json().catch(() => ({}));
        flash(body.error ?? "failed to create link", false);
        $create.disabled = false;
        $create.textContent = "create link";
        return;
      }

      const data = (await res.json()) as {
        share: { token: string; expiresAt: number };
        serve?: { protocol: string; port: number; user: string; password: string; copyCommand: string };
        serveError?: string;
      };
      $linkInput.value = `${location.origin}/share?token=${data.share.token}`;
      $expiryNote.textContent = `expires ${new Date(data.share.expiresAt * 1000).toLocaleString()}`;
      $formView.hidden = true;
      $resultView.hidden = false;

      if (data.serve) {
        $serveBadge.textContent = data.serve.protocol;
        $serveHost.value = location.hostname;
        $servePort.value = String(data.serve.port);
        $serveUser.value = data.serve.user;
        $servePassword.value = data.serve.password;
        $serveCommand.value = data.serve.copyCommand;
        $serveView.hidden = false;
      } else if (data.serveError) {
        $serveError.textContent = `protocol share failed to start: ${data.serveError}`;
        $serveError.hidden = false;
      }

      window.dispatchEvent(new Event("shareLinksChanged"));
    } catch {
      flash("network error", false);
      $create.disabled = false;
      $create.textContent = "create link";
    }
  });

  const copyInput = async ($input: HTMLInputElement, label: string) => {
    $input.select();
    try {
      await navigator.clipboard.writeText($input.value);
      showToast(`${label} copied`);
    } catch {
      showToast("couldn't copy - select and copy manually", "error");
    }
  };

  $copy.addEventListener("click", () => copyInput($linkInput, "link"));
  document.getElementById("serve-host-copy")!.addEventListener("click", () => copyInput($serveHost, "host"));
  document.getElementById("serve-port-copy")!.addEventListener("click", () => copyInput($servePort, "port"));
  document.getElementById("serve-user-copy")!.addEventListener("click", () => copyInput($serveUser, "username"));
  document.getElementById("serve-password-copy")!.addEventListener("click", () => copyInput($servePassword, "password"));
  document.getElementById("serve-command-copy")!.addEventListener("click", () => copyInput($serveCommand, "command"));
</script>

<style>
  #share-dialog {
    width: min(480px, 92vw);
    background-color: var(--secondary);
    color: white;
    border: var(--accent) 1px solid;
    padding: 20px 24px;
    font-family: inherit;
  }

  #share-dialog::backdrop {
    background-color: rgba(0, 0, 0, 0.6);
  }

  .dialog-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .dialog-head h2 {
    margin: 0;
    color: var(--accent);
  }

  .close-btn {
    background: none;
    border: none;
    color: lightgray;
    font-size: 16px;
    cursor: pointer;
    padding: 4px 8px;
  }

  .close-btn:hover {
    color: white;
    background-color: var(--tertiary);
  }

  .hint {
    color: darkgray;
    margin: 6px 0;
    font-size: 0.85em;
    word-break: break-all;
  }

  .row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin: 12px 0;
    flex-wrap: wrap;
  }

  .row > label {
    color: lightgray;
  }

  select,
  input[type="number"],
  input[type="text"] {
    background-color: var(--primary);
    color: white;
    border: 1px solid var(--tertiary);
    padding: 7px 9px;
    font-family: inherit;
    outline: none;
  }

  select:focus,
  input:focus {
    border-color: var(--accent);
  }

  #share-link-input {
    flex: 1;
    min-width: 0;
  }

  .inline {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 10px;
  }

  .btn {
    background-color: var(--accent);
    color: var(--primary);
    border: none;
    padding: 7px 12px;
    font-family: inherit;
    font-weight: bold;
    cursor: pointer;
    white-space: nowrap;
  }

  .btn:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .msg {
    font-size: 0.85em;
  }

  .msg.ok {
    color: var(--accent);
  }

  .msg.err {
    color: #ff6b81;
  }

  .hint.err {
    color: #ff6b81;
  }

  .btn.small {
    padding: 5px 8px;
    font-size: 0.8em;
  }

  .serve-card {
    margin-top: 14px;
    padding: 12px 14px;
    background-color: var(--primary);
    border: 1px solid var(--tertiary);
  }

  .serve-head {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 10px;
  }

  .serve-badge {
    background-color: var(--accent);
    color: var(--primary);
    font-weight: bold;
    font-size: 0.75em;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    padding: 2px 8px;
    border-radius: 2px;
  }

  .serve-fields {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px 14px;
    margin-bottom: 10px;
  }

  .serve-field label {
    display: block;
    color: lightgray;
    font-size: 0.8em;
    margin-bottom: 4px;
  }

  .serve-field input,
  #serve-command {
    font-family: monospace;
  }
</style>
