---
import { PREVIEW_MODES } from "../lib/previewMode";
import { ACCENT_PRESETS, SYNTAX_THEMES } from "../lib/themes";

const user = Astro.locals.user!;
const isAdmin = user.role === "admin";
---

<dialog id="settings-dialog">
  <div class="dialog-head">
    <h2>settings</h2>
    <button class="close-btn" id="settings-close" aria-label="close">✕</button>
  </div>

  <div class="settings-body">
    <div class="tab-rail" role="tablist">
      <button class="tab-btn active" type="button" data-tab="appearance">appearance</button>
      <button class="tab-btn" type="button" data-tab="account">account</button>
      <button class="tab-btn" type="button" data-tab="shares">share links</button>
      {isAdmin && (
        <button class="tab-btn" type="button" data-tab="users">users</button>
      )}
      <button class="tab-btn" type="button" data-tab="history">history</button>
      <button class="tab-btn" type="button" data-tab="trash">trash</button>
    </div>

    <div class="tab-content">
      <section class="tab-panel" data-tab="appearance">
        <h3><span class="rule">──</span> appearance</h3>

        <div class="row">
          <label for="accent-input">accent color</label>
          <div class="accent-controls">
            <input type="color" id="accent-input" value={user.accentColor} />
            {
              ACCENT_PRESETS.map(color => (
                <button class="swatch" data-color={color} style={`background-color: ${color}`} title={color} />
              ))
            }
          </div>
        </div>

        <div class="row">
          <label for="theme-select">syntax highlighting</label>
          <select id="theme-select">
            {
              SYNTAX_THEMES.map(theme => (
                <option value={theme.id} selected={theme.id === user.syntaxTheme}>
                  {theme.label}
                </option>
              ))
            }
          </select>
        </div>

        <div class="row">
          <label for="preview-mode-select">file previews</label>
          <select id="preview-mode-select">
            {
              PREVIEW_MODES.map(mode => (
                <option value={mode.id} selected={mode.id === user.previewMode}>
                  {mode.label}
                </option>
              ))
            }
          </select>
        </div>
      </section>

      <section class="tab-panel" data-tab="account" hidden>
        <h3><span class="rule">──</span> account</h3>

        {
          user.homeDir && (
            <p class="hint">your account is restricted to <code>/{user.homeDir}</code> and everything inside it.</p>
          )
        }

        <div class="row">
          <label>profile picture</label>
          <div class="avatar-controls">
            <div class="avatar-preview" id="avatar-preview">
              {
                user.hasAvatar ? (
                  <img src={`/api/avatar?id=${user.id}`} alt="" />
                ) : (
                  <span>{user.username.slice(0, 2).toUpperCase()}</span>
                )
              }
            </div>
            <input type="file" id="avatar-file" accept="image/*" hidden />
            <button class="btn" id="avatar-upload">upload</button>
            <button class="btn subtle" id="avatar-remove" disabled={!user.hasAvatar}>remove</button>
          </div>
        </div>

        <form id="password-form" class="stack">
          <label for="pw-current">change password</label>
          <input type="password" id="pw-current" placeholder="current password" autocomplete="current-password" required />
          <input
            type="password"
            id="pw-new"
            placeholder="new password (min 8 chars)"
            autocomplete="new-password"
            minlength="8"
            required
          />
          <input type="password" id="pw-confirm" placeholder="confirm new password" autocomplete="new-password" required />
          <div class="inline">
            <button class="btn" type="submit">update password</button>
            <span class="msg" id="pw-msg"></span>
          </div>
        </form>
      </section>

      <section class="tab-panel" id="shares-section" data-tab="shares" hidden>
        <h3><span class="rule">──</span> share links</h3>

        <label class="check show-expired">
          <input type="checkbox" id="shares-show-expired" /> show expired
        </label>

        <div id="shares-list" class="entries-list"></div>
      </section>

      {
        isAdmin && (
          <section class="tab-panel" id="users-section" data-tab="users" hidden>
            <h3>
              <span class="rule">──</span> users
            </h3>

            <div id="users-list" class="entries-list"></div>

            <form id="create-user-form" class="stack">
              <label for="nu-username">add user</label>
              <div class="inline wrap-sm">
                <input type="text" id="nu-username" placeholder="username" autocomplete="off" required />
                <input type="password" id="nu-password" placeholder="password" autocomplete="new-password" minlength="8" required />
                <select id="nu-role">
                  <option value="readonly">readonly</option>
                  <option value="member" selected>
                    member
                  </option>
                  <option value="admin">admin</option>
                </select>
                <input type="text" id="nu-homedir" placeholder="restrict to folder (optional)" autocomplete="off" />
                <button class="btn" type="submit">create</button>
              </div>
              <span class="msg" id="users-msg" />
            </form>
          </section>
        )
      }

      <section class="tab-panel" id="history-section" data-tab="history" hidden>
        <h3><span class="rule">──</span> history</h3>
        <p class="hint">every create, upload, rename, move and delete, in order. reverting undoes everything after that point.</p>
        <div id="history-list" class="entries-list"></div>
        <div class="inline" id="history-more-wrap" hidden>
          <button class="btn subtle" id="history-more" type="button">load more</button>
        </div>
      </section>

      <section class="tab-panel" id="trash-section" data-tab="trash" hidden>
        <div class="trash-head">
          <h3><span class="rule">──</span> trash</h3>
          <button class="btn subtle" id="trash-empty" type="button" hidden>empty trash</button>
        </div>
        <div id="trash-list" class="entries-list"></div>
      </section>
    </div>
  </div>
</dialog>

<script define:vars={{ currentUserId: user.id, isAdmin }}>
  window.__currentUserId = currentUserId;
  window.__isAdmin = isAdmin;
</script>

<script>
  import { html, render } from "lit-html";
  import { confirmAction } from "../lib/confirmDialog";
  import { notifyFsChanged } from "../lib/folderActions";
  import { showToast } from "../lib/toast";

  declare global {
    interface Window {
      __currentUserId: number;
      __isAdmin: boolean;
    }
  }

  const $dialog = document.getElementById("settings-dialog") as HTMLDialogElement;
  const currentUserId = window.__currentUserId;
  const isAdmin = window.__isAdmin;

  document.getElementById("settings-close")!.addEventListener("click", () => $dialog.close());
  // close when clicking the backdrop (the dialog element itself, not its children)
  $dialog.addEventListener("click", e => {
    if (e.target === $dialog) $dialog.close();
  });

  const patchMe = (body: Record<string, unknown>) =>
    fetch("/api/me", {
      method: "PATCH",
      headers: { "content-type": "application/json" },
      body: JSON.stringify(body)
    });

  // ---- tabs ----

  const $tabButtons = Array.from(document.querySelectorAll<HTMLButtonElement>(".tab-btn"));
  const $tabPanels = Array.from(document.querySelectorAll<HTMLElement>(".tab-panel"));

  for (const btn of $tabButtons) {
    btn.addEventListener("click", () => {
      const tab = btn.dataset.tab!;
      for (const b of $tabButtons) b.classList.toggle("active", b === btn);
      for (const panel of $tabPanels) panel.hidden = panel.dataset.tab !== tab;
    });
  }

  // ---- accent color ----

  const $accent = document.getElementById("accent-input") as HTMLInputElement;

  const applyAccent = (color: string) => {
    document.documentElement.style.setProperty("--accent", color);
  };

  let accentTimer: ReturnType<typeof setTimeout> | undefined;
  const saveAccent = (color: string) => {
    applyAccent(color);
    clearTimeout(accentTimer);
    accentTimer = setTimeout(() => patchMe({ accentColor: color }), 250);
  };

  $accent.addEventListener("input", () => saveAccent($accent.value));

  for (const swatch of document.querySelectorAll<HTMLButtonElement>(".swatch")) {
    swatch.addEventListener("click", () => {
      const color = swatch.dataset.color!;
      $accent.value = color;
      saveAccent(color);
    });
  }

  // ---- syntax theme ----

  const $theme = document.getElementById("theme-select") as HTMLSelectElement;
  $theme.addEventListener("change", () => patchMe({ syntaxTheme: $theme.value }));

  // ---- preview mode ----

  const $previewMode = document.getElementById("preview-mode-select") as HTMLSelectElement;
  $previewMode.addEventListener("change", () => {
    // instant feedback, same as accent color - Explorer.astro applies it live
    window.dispatchEvent(new CustomEvent("previewModeChange", { detail: $previewMode.value }));
    patchMe({ previewMode: $previewMode.value });
  });

  // ---- avatar ----

  const $avatarFile = document.getElementById("avatar-file") as HTMLInputElement;
  const $avatarPreview = document.getElementById("avatar-preview")!;
  const $avatarRemove = document.getElementById("avatar-remove") as HTMLButtonElement;
  const $panelAvatar = document.getElementById("panel-avatar");

  const setAvatarViews = (hasAvatar: boolean) => {
    const src = `/api/avatar?id=${currentUserId}&t=${Date.now()}`;
    const initials = $panelAvatar?.dataset.initials ?? "?";
    const content = hasAvatar ? `<img src="${src}" alt="">` : `<span>${initials}</span>`;
    $avatarPreview.innerHTML = content;
    if ($panelAvatar) $panelAvatar.innerHTML = content;
    $avatarRemove.disabled = !hasAvatar;
  };

  document.getElementById("avatar-upload")!.addEventListener("click", e => {
    e.preventDefault();
    $avatarFile.click();
  });

  $avatarFile.addEventListener("change", async () => {
    const file = $avatarFile.files?.[0];
    if (!file) return;
    const form = new FormData();
    form.append("file", file);
    const res = await fetch("/api/avatar", { method: "POST", body: form });
    if (res.ok) setAvatarViews(true);
    $avatarFile.value = "";
  });

  $avatarRemove.addEventListener("click", async e => {
    e.preventDefault();
    const res = await fetch("/api/avatar", { method: "DELETE" });
    if (res.ok) setAvatarViews(false);
  });

  // ---- change password ----

  const $pwForm = document.getElementById("password-form") as HTMLFormElement;
  const $pwCurrent = document.getElementById("pw-current") as HTMLInputElement;
  const $pwNew = document.getElementById("pw-new") as HTMLInputElement;
  const $pwConfirm = document.getElementById("pw-confirm") as HTMLInputElement;
  const $pwMsg = document.getElementById("pw-msg")!;

  const flash = (el: HTMLElement, text: string, ok: boolean) => {
    el.textContent = text;
    el.classList.toggle("ok", ok);
    el.classList.toggle("err", !ok);
  };

  $pwForm.addEventListener("submit", async e => {
    e.preventDefault();
    if ($pwNew.value !== $pwConfirm.value) {
      flash($pwMsg, "passwords do not match", false);
      return;
    }
    const res = await patchMe({ currentPassword: $pwCurrent.value, newPassword: $pwNew.value });
    if (res.ok) {
      flash($pwMsg, "password updated", true);
      $pwForm.reset();
    } else {
      const body = await res.json().catch(() => ({}));
      flash($pwMsg, body.error ?? "update failed", false);
    }
  });

  // ---- share links ----

  type TShareEntry = {
    token: string;
    path: string;
    createdBy: number;
    createdByUsername: string;
    createdAt: number;
    expiresAt: number;
    protocol: string | null;
    servePort: number | null;
  };

  const $sharesList = document.getElementById("shares-list")!;
  const $showExpired = document.getElementById("shares-show-expired") as HTMLInputElement;

  const nowS = () => Math.floor(Date.now() / 1000);
  const isExpired = (s: TShareEntry) => s.expiresAt <= nowS();
  const shareUrl = (token: string) => `${location.origin}/share?token=${token}`;

  let sharesLoaded = false;
  const loadShares = async () => {
    if (!sharesLoaded) render(html`<span class="dim">loading...</span>`, $sharesList);
    const res = await fetch(`/api/shares?includeExpired=${$showExpired.checked ? "1" : "0"}`);
    if (!res.ok) {
      render(html`<span class="dim">failed to load share links</span>`, $sharesList);
      return;
    }
    const { shares } = (await res.json()) as { shares: TShareEntry[] };
    sharesLoaded = true;
    renderShares(shares);
  };

  const copyShare = async (s: TShareEntry) => {
    try {
      await navigator.clipboard.writeText(shareUrl(s.token));
      showToast("link copied");
    } catch {
      showToast("couldn't copy link", "error");
    }
  };

  const revokeShare = async (s: TShareEntry) => {
    const confirmed = await confirmAction({
      message: `revoke the share link for "/${s.path || ""}"?`,
      confirmLabel: "revoke",
      danger: true,
      key: "revoke-share"
    });
    if (!confirmed) return;
    const res = await fetch(`/api/shares?token=${encodeURIComponent(s.token)}`, { method: "DELETE" });
    if (!res.ok) {
      const body = await res.json().catch(() => ({}));
      showToast(body.error ?? "failed to revoke link", "error");
    }
    loadShares();
  };

  const renderShares = (shares: TShareEntry[]) => {
    if (shares.length === 0) {
      render(html`<span class="dim">no share links${$showExpired.checked ? "" : " (excluding expired)"}</span>`, $sharesList);
      return;
    }
    render(
      html`${shares.map(s => {
        const expired = isExpired(s);
        const canRevoke = s.createdBy === currentUserId || isAdmin;
        return html`
          <div class="entry-row">
            <div class="entry-info">
              <span class="row-name" title=${`/${s.path}`}>/${s.path || "(root)"}</span>
              <span class="row-role"
                >shared by ${s.createdByUsername} · ${new Date(s.createdAt * 1000).toLocaleDateString()} ·
                ${expired
                  ? html`<span class="expired-badge">expired</span>`
                  : `expires ${new Date(s.expiresAt * 1000).toLocaleString()}`}
                ${s.protocol && !expired
                  ? html` · <span class="protocol-badge">${s.protocol} :${s.servePort}</span>`
                  : ""}</span
              >
            </div>
            <div class="row-actions">
              ${!expired ? html`<button class="mini" title="copy link" @click=${() => copyShare(s)}>copy link</button>` : ""}
              ${canRevoke
                ? html`<button class="mini danger" title="revoke" @click=${() => revokeShare(s)}>revoke</button>`
                : ""}
            </div>
          </div>
        `;
      })}`,
      $sharesList
    );
  };

  $showExpired.addEventListener("change", loadShares);
  window.addEventListener("shareLinksChanged", loadShares);

  // ---- user management (only rendered for admins) ----

  const $usersList = document.getElementById("users-list");

  type TRole = "readonly" | "member" | "admin";

  type TUserEntry = {
    id: number;
    username: string;
    role: TRole;
    homeDir: string | null;
    hasAvatar: boolean;
    createdAt: number;
  };

  const ROLES: TRole[] = ["readonly", "member", "admin"];

  // reassigned below when $usersList exists (admins only) - a harmless no-op otherwise, so
  // the settingsOpen handler at the bottom of this script can call it unconditionally
  let loadUsers: () => Promise<void> = async () => {};

  if ($usersList) {
    const $createForm = document.getElementById("create-user-form") as HTMLFormElement;
    const $nuUsername = document.getElementById("nu-username") as HTMLInputElement;
    const $nuPassword = document.getElementById("nu-password") as HTMLInputElement;
    const $nuRole = document.getElementById("nu-role") as HTMLSelectElement;
    const $nuHomeDir = document.getElementById("nu-homedir") as HTMLInputElement;
    const $usersMsg = document.getElementById("users-msg")!;

    // admins can't be restricted to a folder - keep the field out of the way while that
    // role is selected rather than letting it silently get ignored on submit
    const syncHomeDirField = () => {
      const isAdminRole = $nuRole.value === "admin";
      $nuHomeDir.disabled = isAdminRole;
      if (isAdminRole) $nuHomeDir.value = "";
    };
    $nuRole.addEventListener("change", syncHomeDirField);
    syncHomeDirField();

    // every state must go through lit-html's render: writing textContent directly would
    // destroy lit's part markers and break all subsequent renders into this container
    let usersLoaded = false;

    const act = async (req: Promise<Response>, okMsg: string) => {
      const res = await req;
      if (res.ok) {
        flash($usersMsg, okMsg, true);
      } else {
        const body = await res.json().catch(() => ({}));
        flash($usersMsg, body.error ?? "action failed", false);
      }
      loadUsers();
    };

    const resetPassword = (u: TUserEntry) => {
      const password = prompt(`new password for ${u.username} (min 8 chars):`);
      if (!password) return;
      act(
        fetch("/api/users", {
          method: "PATCH",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({ id: u.id, password })
        }),
        `password reset for ${u.username}`
      );
    };

    const changeRole = (u: TUserEntry, role: TRole) => {
      if (role === u.role) return;
      act(
        fetch("/api/users", {
          method: "PATCH",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({ id: u.id, role })
        }),
        `${u.username} is now ${role}`
      );
    };

    const setHomeDir = (u: TUserEntry) => {
      const input = prompt(
        `restrict ${u.username} to a folder (path relative to the file root, e.g. "Photos/Family").\nleave blank to remove any restriction:`,
        u.homeDir ?? ""
      );
      if (input === null) return; // cancelled
      act(
        fetch("/api/users", {
          method: "PATCH",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({ id: u.id, homeDir: input.trim() || null })
        }),
        input.trim() ? `${u.username} restricted to "/${input.trim()}"` : `${u.username} is no longer restricted`
      );
    };

    const deleteUser = async (u: TUserEntry) => {
      const confirmed = await confirmAction({
        message: `delete ${u.username}? this cannot be undone.`,
        confirmLabel: "delete",
        danger: true,
        key: "delete-user"
      });
      if (!confirmed) return;
      act(fetch(`/api/users?id=${u.id}`, { method: "DELETE" }), `deleted ${u.username}`);
    };

    const renderUsers = (users: TUserEntry[]) => {
      render(
        html`${users.map(u => {
          const isSelf = u.id === currentUserId;
          return html`
            <div class="entry-row">
              <div class="row-avatar">
                ${u.hasAvatar
                  ? html`<img src=${`/api/avatar?id=${u.id}&t=${Date.now()}`} alt="" />`
                  : html`<span>${u.username.slice(0, 2).toUpperCase()}</span>`}
              </div>
              <div class="entry-info">
                <span class="row-name" title=${u.username}>${u.username}${isSelf ? " (you)" : ""}</span>
                ${u.homeDir
                  ? html`<span class="row-role" title=${`/${u.homeDir}`}>restricted to /${u.homeDir}</span>`
                  : ""}
              </div>
              <select
                class="role-select"
                title="change role"
                ?disabled=${isSelf}
                @change=${(e: Event) => changeRole(u, (e.target as HTMLSelectElement).value as TRole)}
              >
                ${ROLES.map(role => html`<option value=${role} ?selected=${role === u.role}>${role}</option>`)}
              </select>
              <div class="row-actions">
                ${u.role !== "admin"
                  ? html`<button class="mini" title="restrict to folder" @click=${() => setHomeDir(u)}>folder</button>`
                  : ""}
                <button class="mini" title="reset password" @click=${() => resetPassword(u)}>reset pw</button>
                <button class="mini danger" title="delete user" ?disabled=${isSelf} @click=${() => deleteUser(u)}>
                  delete
                </button>
              </div>
            </div>
          `;
        })}`,
        $usersList
      );
    };

    loadUsers = async () => {
      if (!usersLoaded) render(html`<span class="dim">loading...</span>`, $usersList);
      const res = await fetch("/api/users");
      if (!res.ok) {
        render(html`<span class="dim">failed to load users</span>`, $usersList);
        return;
      }
      const { users } = (await res.json()) as { users: TUserEntry[] };
      usersLoaded = true;
      renderUsers(users);
    };

    $createForm.addEventListener("submit", e => {
      e.preventDefault();
      act(
        fetch("/api/users", {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({
            username: $nuUsername.value,
            password: $nuPassword.value,
            role: $nuRole.value,
            homeDir: $nuHomeDir.value.trim() || undefined
          })
        }),
        `created ${$nuUsername.value}`
      ).then(() => $createForm.reset());
    });
  }

  // ---- history (audit log) ----

  type TAuditAction = "create_folder" | "upload" | "move" | "delete" | "restore" | "purge";

  type TAuditEntry = {
    id: number;
    userId: number;
    username: string;
    action: TAuditAction;
    path: string;
    detail: string | null;
    undoneAt: number | null;
    undoneBy: number | null;
    undoneByUsername: string | null;
    purgedAt: number | null;
    purgedBy: number | null;
    purgedByUsername: string | null;
    createdAt: number;
  };

  const $historyList = document.getElementById("history-list")!;
  const $historyMoreWrap = document.getElementById("history-more-wrap")!;
  const $historyMore = document.getElementById("history-more")!;

  const fmtSize = (n: number | null | undefined): string => {
    if (n == null) return "";
    if (n < 1024) return `${n} B`;
    const units = ["KB", "MB", "GB", "TB"];
    let v = n / 1024;
    let i = 0;
    while (v >= 1024 && i < units.length - 1) {
      v /= 1024;
      i++;
    }
    return `${v.toFixed(1)} ${units[i]}`;
  };

  const baseName = (path: string): string => path.split("/").filter(Boolean).pop() ?? path;

  const describeEntry = (e: TAuditEntry): string => {
    const detail = e.detail ? JSON.parse(e.detail) : null;
    switch (e.action) {
      case "create_folder":
        return `created folder "/${e.path}"`;
      case "upload":
        return `uploaded "${baseName(e.path)}"${detail?.size != null ? ` (${fmtSize(detail.size)})` : ""}`;
      case "move": {
        const { from, to } = detail as { from: string; to: string };
        const sameParent = from.split("/").slice(0, -1).join("/") === to.split("/").slice(0, -1).join("/");
        return sameParent
          ? `renamed "${baseName(from)}" to "${baseName(to)}"`
          : `moved "/${from}" to "/${to}"`;
      }
      case "delete":
        return `deleted "/${e.path}"`;
      case "restore": {
        const { restoredPath } = detail as { restoredPath: string };
        return `restored "/${restoredPath}"`;
      }
      case "purge":
        return `permanently deleted "/${e.path}"`;
    }
  };

  const canRevert = (e: TAuditEntry): boolean => isAdmin && !e.undoneAt && !e.purgedAt && e.action !== "purge";

  // affected parent dirs from every entry in `list` whose id is in `ids` - used to refresh
  // Explorer/Sidebar after a revert, which can touch paths well outside the current view
  const affectedPaths = (list: TAuditEntry[], ids: number[]): string[][] => {
    const paths: string[][] = [];
    for (const e of list) {
      if (!ids.includes(e.id)) continue;
      paths.push(e.path.split("/").filter(Boolean));
      if (e.action === "move" && e.detail) {
        const { from } = JSON.parse(e.detail) as { from: string };
        paths.push(from.split("/").filter(Boolean));
      }
    }
    return paths;
  };

  let historyEntries: TAuditEntry[] = [];
  let historyHasMore = false;
  let historyLoaded = false;

  const loadHistory = async (reset: boolean) => {
    if (reset) {
      if (!historyLoaded) render(html`<span class="dim">loading...</span>`, $historyList);
      historyEntries = [];
    }
    const beforeId = reset ? undefined : historyEntries.at(-1)?.id;
    const res = await fetch(beforeId ? `/api/audit?beforeId=${beforeId}` : "/api/audit");
    if (!res.ok) {
      render(html`<span class="dim">failed to load history</span>`, $historyList);
      return;
    }
    const { entries, hasMore } = (await res.json()) as { entries: TAuditEntry[]; hasMore: boolean };
    historyLoaded = true;
    historyEntries = reset ? entries : [...historyEntries, ...entries];
    historyHasMore = hasMore;
    renderHistory();
  };

  const revertToHere = async (e: TAuditEntry) => {
    const confirmed = await confirmAction({
      message: `revert to just after "${describeEntry(e)}"? every action since then will be undone.`,
      confirmLabel: "revert",
      danger: true,
      key: "revert-history"
    });
    if (!confirmed) return;
    const res = await fetch("/api/audit", {
      method: "POST",
      headers: { "content-type": "application/json" },
      body: JSON.stringify({ id: e.id })
    });
    if (!res.ok) {
      const body = await res.json().catch(() => ({}));
      showToast(body.error ?? "revert failed", "error");
      return;
    }
    const result = (await res.json()) as { reverted: number[]; failedAt?: { id: number; error: string } };
    notifyFsChanged(affectedPaths(historyEntries, result.reverted));
    if (result.failedAt) {
      showToast(`reverted ${result.reverted.length} action(s), then stopped: ${result.failedAt.error}`, "error");
    } else {
      showToast(`reverted ${result.reverted.length} action(s)`, "success");
    }
    loadHistory(true);
    loadTrash();
  };

  const renderHistory = () => {
    $historyMoreWrap.hidden = !historyHasMore;
    if (historyEntries.length === 0) {
      render(html`<span class="dim">no activity yet</span>`, $historyList);
      return;
    }
    render(
      html`${historyEntries.map(e => {
        const settled = e.undoneAt || e.purgedAt;
        return html`
          <div class="entry-row ${settled ? "settled" : ""}">
            <div class="entry-info">
              <span class="row-name">${describeEntry(e)}</span>
              <span class="row-role">
                ${e.username} · ${new Date(e.createdAt * 1000).toLocaleString()}
                ${e.undoneAt ? html` · <span class="settled-badge">reverted by ${e.undoneByUsername}</span>` : ""}
                ${e.purgedAt ? html` · <span class="settled-badge">purged by ${e.purgedByUsername}</span>` : ""}
              </span>
            </div>
            ${canRevert(e)
              ? html`<div class="row-actions">
                  <button class="mini" title="revert to here" @click=${() => revertToHere(e)}>revert to here</button>
                </div>`
              : ""}
          </div>
        `;
      })}`,
      $historyList
    );
  };

  $historyMore.addEventListener("click", () => loadHistory(false));

  // ---- trash ----

  type TDeleteDetail = { trashId: string; isDir: boolean; size: number | null };

  const $trashList = document.getElementById("trash-list")!;
  const $trashEmpty = document.getElementById("trash-empty") as HTMLButtonElement;

  let trashItems: TAuditEntry[] = [];
  let trashLoaded = false;

  const loadTrash = async () => {
    if (!trashLoaded) render(html`<span class="dim">loading...</span>`, $trashList);
    const res = await fetch("/api/trash");
    if (!res.ok) {
      render(html`<span class="dim">failed to load trash</span>`, $trashList);
      return;
    }
    const { items } = (await res.json()) as { items: TAuditEntry[] };
    trashLoaded = true;
    trashItems = items;
    renderTrash();
  };

  const restoreTrashItem = async (e: TAuditEntry) => {
    const res = await fetch("/api/trash", {
      method: "PATCH",
      headers: { "content-type": "application/json" },
      body: JSON.stringify({ id: e.id })
    });
    if (!res.ok) {
      const body = await res.json().catch(() => ({}));
      showToast(body.error ?? "restore failed", "error");
      return;
    }
    const { path } = (await res.json()) as { path: string };
    notifyFsChanged([e.path.split("/").filter(Boolean), path.split("/").filter(Boolean)]);
    showToast(`restored to "/${path}"`, "success");
    loadTrash();
    loadHistory(true);
  };

  const purgeTrashItem = async (e: TAuditEntry) => {
    const confirmed = await confirmAction({
      message: `permanently delete "${baseName(e.path)}"? this cannot be undone.`,
      confirmLabel: "delete forever",
      danger: true,
      key: "purge-trash-item"
    });
    if (!confirmed) return;
    const res = await fetch(`/api/trash?id=${e.id}`, { method: "DELETE" });
    if (!res.ok) {
      const body = await res.json().catch(() => ({}));
      showToast(body.error ?? "delete failed", "error");
      return;
    }
    showToast(`"${baseName(e.path)}" permanently deleted`, "success");
    loadTrash();
    loadHistory(true);
  };

  $trashEmpty.addEventListener("click", async () => {
    const confirmed = await confirmAction({
      message: "permanently delete everything in trash? this cannot be undone.",
      confirmLabel: "empty trash",
      danger: true,
      key: "empty-trash"
    });
    if (!confirmed) return;
    const res = await fetch("/api/trash?all=1", { method: "DELETE" });
    if (!res.ok) {
      const body = await res.json().catch(() => ({}));
      showToast(body.error ?? "failed to empty trash", "error");
      return;
    }
    const { purged } = (await res.json()) as { purged: number };
    showToast(`emptied trash (${purged} item${purged === 1 ? "" : "s"})`, "success");
    loadTrash();
    loadHistory(true);
  });

  const renderTrash = () => {
    $trashEmpty.hidden = !isAdmin || trashItems.length === 0;
    if (trashItems.length === 0) {
      render(html`<span class="dim">trash is empty</span>`, $trashList);
      return;
    }
    render(
      html`${trashItems.map(e => {
        const d = JSON.parse(e.detail!) as TDeleteDetail;
        return html`
          <div class="entry-row">
            <div class="entry-info">
              <span class="row-name" title=${`/${e.path}`}>${d.isDir ? "📁" : "📄"} ${baseName(e.path)}</span>
              <span class="row-role">
                deleted by ${e.username} · ${new Date(e.createdAt * 1000).toLocaleString()}
                ${d.size != null ? ` · ${fmtSize(d.size)}` : ""}
              </span>
            </div>
            ${isAdmin
              ? html`<div class="row-actions">
                  <button class="mini" title="restore" @click=${() => restoreTrashItem(e)}>restore</button>
                  <button class="mini danger" title="delete forever" @click=${() => purgeTrashItem(e)}>delete forever</button>
                </div>`
              : ""}
          </div>
        `;
      })}`,
      $trashList
    );
  };

  // ---- load everything fresh whenever the dialog opens ----

  window.addEventListener("settingsOpen", () => {
    loadShares();
    loadUsers();
    loadHistory(true);
    loadTrash();
  });
</script>

