# absolute or relative path to the directory of files to serve
ROOT_DIR=./files

# optional: where generated thumbnails are cached (defaults to ./.thumbs)
THUMBS_DIR=./.bowser/thumbs

# optional: where the sqlite database (users, sessions, settings) lives (defaults to ./data/app.db)
DB_PATH=./.bowser/db/app.db

# optional: rclone binary used to serve shares over WebDAV/SFTP/FTP/HTTP (defaults to "rclone" on PATH)
RCLONE_BIN=rclone

# optional: cap on concurrently running rclone-serve processes, one per protocol-enabled share (defaults to 20)
MAX_RCLONE_SERVES=20
